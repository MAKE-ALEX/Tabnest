# 宿主机端口（默认 8420）
PORT=8420

# 访问密码；非空时启用登录。留空时只允许监听 127.0.0.1，
# 若确实要在内网无鉴权运行，需同时设置 ALLOW_INSECURE=true。
APP_PASSWORD=

# 首次启动时是否写入示例面板
SEED_DEMO=true

# 允许服务端抓取内网 / 本机地址（默认关闭，开启前请确认 SSRF 风险）
# ALLOW_PRIVATE_NETWORK=false

# 通过 HTTPS 反向代理 / Cloudflare Tunnel 访问时打开
# COOKIE_SECURE=true

# 仅信任来自这些网段的代理头（推荐；替代旧的 TRUST_PROXY）
# 例如 Docker 网络：172.16.0.0/12
# TRUSTED_PROXIES=172.16.0.0/12

# 无密码时的逃生开关：只有在你明确接受“任何人可读写”时才打开
# ALLOW_INSECURE=false

# 国内网络可取消注释，加速首次 Docker 构建（可选）
# CARGO_REGISTRY_MIRROR=https://rsproxy.cn/index/
# DEBIAN_MIRROR=mirrors.aliyun.com

TZ=Asia/Shanghai
